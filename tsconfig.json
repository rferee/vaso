{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"importHelpers": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["DOM", "ES2021"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
